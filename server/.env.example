# ExamGuard Pro - Server Environment
# Copy to server/.env and fill in values.

# Supabase project and current key names
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Legacy alias supported for older deployments
# SUPABASE_KEY=

# JWT / custom application auth
SECRET_KEY=replace-with-a-long-random-secret

# Supabase PostgreSQL pooler
PG_HOST=your-pooler-host
PG_PORT=6543
PG_USER=postgres.your-project-ref
PG_DB=postgres
PG_PASSWORD=your-database-password

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage buckets
REPORTS_BUCKET=reports
SCREENSHOTS_BUCKET=screenshots

# API
CORS_ORIGINS=http://localhost:3000
