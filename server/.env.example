# ExamGuard Pro - Server Environment (optional for local dev)
# Copy to server/.env and fill in values. The app runs without Supabase using in-memory fallbacks.

# Supabase (optional — enables persistent storage)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-role-or-anon-key

# JWT / auth
# SECRET_KEY=change-me-in-production

# Database (optional — defaults to SQLite at server/examguard.db)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/examguard

# API
# API_HOST=0.0.0.0
# API_PORT=8000
